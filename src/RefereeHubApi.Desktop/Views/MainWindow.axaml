<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RefereeHubApi.Desktop.ViewModels"
        xmlns:c="using:RefereeHubApi.Desktop.Controls"
        x:Class="RefereeHubApi.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RefereeHub" Width="1440" Height="980" MinWidth="900" MinHeight="640">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- toolbar -->
        <Border Grid.Row="0" IsVisible="{Binding IsSignedIn}" Background="{StaticResource Bar}"
                BorderBrush="{StaticResource BarLine}" BorderThickness="0,0,0,1" Height="44" Padding="12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                    <Button Theme="{StaticResource Icon}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings"
                            Command="{Binding ShowSettingsCommand}">
                        <c:Icon Kind="settings" Width="18" Height="18" />
                    </Button>
                    <Button Theme="{StaticResource Icon}" ToolTip.Tip="Rooms" AutomationProperties.Name="Rooms"
                            Command="{Binding ShowRoomsCommand}">
                        <c:Icon Kind="home" Width="18" Height="18" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding RoomTabs}" Margin="6,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomViewModel">
                                <Button Theme="{StaticResource Plain}" Height="44" Padding="14,0"
                                        Background="{Binding TabBackground}" BorderBrush="{Binding TabLine}" BorderThickness="0,0,0,2"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRoomCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding TabTitle}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{Binding TabForeground}" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding HasBadge}" Background="{StaticResource Accent}" CornerRadius="999"
                                                MinWidth="16" Padding="4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource AccentFg}" HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Theme="{StaticResource Icon}" Width="32" ToolTip.Tip="Make or join a room"
                            AutomationProperties.Name="Make or join a room" Command="{Binding ShowRoomsCommand}">
                        <c:Icon Kind="plus" Width="14" Height="14" StrokeWidth="2.5" Foreground="{StaticResource Muted}" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Name="PmButton" Theme="{StaticResource Icon}" ToolTip.Tip="Private messages" AutomationProperties.Name="Private messages">
                        <Panel>
                            <c:Icon Kind="chat" Width="18" Height="18" />
                            <Ellipse IsVisible="{Binding HasUnreadPm}" Width="8" Height="8" Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" />
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opened="pmOpened" Closed="pmClosed">
                                <Grid ColumnDefinitions="180,320" RowDefinitions="*,Auto" Height="420">
                                    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding PrivateChats}" SelectedItem="{Binding SelectedChat}"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PmThreadViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Chip}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="ExtraBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <Ellipse IsVisible="{Binding Unread}" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" FontSize="12" Margin="8" TextWrapping="Wrap"
                                               IsVisible="{Binding !PrivateChats.Count}" Text="No conversations yet." />
                                    <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                                        <ItemsControl ItemsSource="{Binding SelectedChat.Messages, FallbackValue={x:Null}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChatLineViewModel">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Who}" FontWeight="Bold" Foreground="{Binding WhoBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontStyle="{Binding Style}" Foreground="{StaticResource Body}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,10,0,0">
                                        <TextBox Text="{Binding PmTarget}" PlaceholderText="To (username or #id), blank = selected chat" />
                                        <TextBox Text="{Binding PmInput}" PlaceholderText="Message" KeyDown="pmKeyDown" />
                                    </StackPanel>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Theme="{StaticResource Icon}" ToolTip.Tip="Background errors" AutomationProperties.Name="Background errors" Margin="0,0,6,0">
                        <Panel>
                            <c:Icon Kind="warn" Width="18" Height="18" />
                            <Ellipse IsVisible="{Binding HasNewErrors}" Width="8" Height="8" Fill="{StaticResource Yellow}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" />
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opened="errorsOpened">
                                <ScrollViewer MaxHeight="360" Width="420">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="section" Text="ERRORS" />
                                        <TextBlock Classes="muted" IsVisible="{Binding !Errors.Count}" Text="Nothing so far." />
                                        <ItemsControl ItemsSource="{Binding Errors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2" Foreground="{StaticResource Body}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding HubBrush}" />
                        <TextBlock Text="{Binding HubText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" />
                    </StackPanel>
                    <Border Classes="chip" Background="{Binding ChatBg}" ToolTip.Tip="{Binding ChatTitle}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ChatText}" Foreground="{Binding ChatFg}" />
                    </Border>
                    <TextBlock Text="{Binding ClockText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Theme="{StaticResource Icon}" Width="34" Height="34" Background="{StaticResource Chip}"
                            ToolTip.Tip="{Binding AccountName}" AutomationProperties.Name="Account">
                        <TextBlock Text="{Binding AccountInitials}" FontWeight="Bold" FontSize="12" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding AccountName}" IsEnabled="False" />
                                <MenuItem Header="Settings" Command="{Binding ShowSettingsCommand}" />
                                <MenuItem Header="Sign out" Command="{Binding SignOutCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Panel />
            </DockPanel>
        </Border>

        <!-- server restarting -->
        <Border Grid.Row="1" IsVisible="{Binding ShutdownVisible}" Margin="28,12,28,0" Background="{StaticResource Danger}" Padding="18,10">
            <Border.RenderTransform>
                <SkewTransform AngleX="-10" />
            </Border.RenderTransform>
            <DockPanel>
                <DockPanel.RenderTransform>
                    <SkewTransform AngleX="10" />
                </DockPanel.RenderTransform>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                    <Button Theme="{StaticResource Skew}" Background="{StaticResource DangerFg}" Foreground="{StaticResource RedPale}"
                            Content="Reconnect" Command="{Binding ReconnectCommand}" />
                    <Button Theme="{StaticResource Skew}" Background="Transparent" BorderBrush="{StaticResource DangerFg}" BorderThickness="2"
                            Foreground="{StaticResource DangerFg}" Content="Close rooms &amp; reconnect"
                            Command="{Binding ReconnectCommand}" CommandParameter="close" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="SERVER RESTARTING" FontWeight="ExtraBold" LetterSpacing="0.8" Foreground="{StaticResource DangerFg}" VerticalAlignment="Center" />
                    <TextBlock Classes="display" Text="{Binding ShutdownClock}" FontSize="26" FontWeight="Medium" Foreground="{StaticResource DangerFg}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding Page}" />

        <!-- error toast -->
        <Border Grid.Row="2" IsVisible="{Binding HasToast}" Background="{StaticResource ErrorBg}" CornerRadius="10"
                Padding="16,10" Margin="0,0,0,90" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="720">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <c:Icon Kind="warn" Foreground="{StaticResource ErrorFg}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Toast}" Foreground="{StaticResource ErrorPale}" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center" />
                <Button Theme="{StaticResource Icon}" Width="28" Height="28" Command="{Binding DismissToastCommand}" AutomationProperties.Name="Dismiss">
                    <c:Icon Kind="close" Width="12" Height="12" Foreground="{StaticResource ErrorFg}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
