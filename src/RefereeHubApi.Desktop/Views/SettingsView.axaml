<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RefereeHubApi.Desktop.ViewModels"
             xmlns:c="using:RefereeHubApi.Desktop.Controls"
             xmlns:v="using:RefereeHubApi.Desktop.Views"
             x:Class="RefereeHubApi.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.heading">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Border.heading > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <c:TriangleField Seed="19" BiasX="0.9" />
        <ScrollViewer>
            <StackPanel Margin="28,14,28,24" Spacing="14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Theme="{StaticResource Skew}" Background="{StaticResource ErrorBg}" Foreground="{StaticResource ErrorFg}"
                            FontWeight="ExtraBold" Content="Sign out" VerticalAlignment="Center"
                            Command="{Binding $parent[v:MainView].((vm:MainWindowViewModel)DataContext).SignOutCommand}" />
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Classes="mono" Text="{Binding FilePath}" />
                    </StackPanel>
                </DockPanel>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                    <StackPanel Grid.Column="0" Spacing="14">
                        <!-- highlights -->
                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <Border Classes="heading skew">
                                    <TextBlock Text="HIGHLIGHTS" />
                                </Border>
                                <ToggleSwitch IsChecked="{Binding Mentions}" OnContent="My username in chat" OffContent="My username in chat" />
                                <ToggleSwitch IsChecked="{Binding RefereeCalls}" OnContent="Someone says &quot;ref&quot;" OffContent="Someone says &quot;ref&quot;" />
                                <ToggleSwitch IsChecked="{Binding PrivateMessages}" OnContent="Private messages" OffContent="Private messages" />
                                <TextBlock Classes="label" Text="KEYWORDS" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding Keywords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KeywordViewModel">
                                            <Border Classes="chip" Background="{StaticResource Chip}" Padding="10,2,4,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Word}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Theme="{StaticResource Icon}" Width="20" Height="20" Command="{Binding RemoveCommand}"
                                                            AutomationProperties.Name="{Binding RemoveLabel}">
                                                        <c:Icon Kind="close" Width="10" Height="10" StrokeWidth="2.5" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding NewKeyword}" PlaceholderText="add keyword, Enter" KeyDown="keywordKeyDown" AutomationProperties.Name="Add keyword" />
                            </StackPanel>
                        </Border>

                        <!-- timer -->
                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <Border Classes="heading skew">
                                    <TextBlock Text="PICK TIMER IN CHAT" />
                                </Border>
                                <ToggleSwitch IsChecked="{Binding AnnounceTimer}" OnContent="Post timer to room chat" OffContent="Post timer to room chat" />
                                <StackPanel Spacing="10" IsEnabled="{Binding AnnounceTimer}">
                                    <ToggleSwitch IsChecked="{Binding AnnounceStart}" OnContent="Announce when it starts" OffContent="Announce when it starts" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ItemsControl ItemsSource="{Binding Milestones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MilestoneViewModel">
                                                    <Button Theme="{StaticResource Skew}" Background="{StaticResource TimerBg}" Foreground="{StaticResource TimerFg}"
                                                            MinHeight="30" Padding="12,0" Content="{Binding Label}" Command="{Binding RemoveCommand}"
                                                            ToolTip.Tip="Click to remove" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding NewMilestone}" PlaceholderText="0:45" Width="70" MinHeight="30" KeyDown="milestoneKeyDown"
                                                 AutomationProperties.Name="Add milestone" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Classes="label" Text="START" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding StartedMessage}" />
                                        <TextBlock Grid.Row="1" Classes="label" Text="MILESTONE" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding MilestoneMessage}" />
                                        <TextBlock Grid.Row="2" Classes="label" Text="FINISHED" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding FinishedMessage}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="14">
                        <!-- sounds -->
                        <Border Classes="section">
                            <StackPanel Spacing="6">
                                <Border Classes="heading skew">
                                    <TextBlock Text="SOUNDS" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AlertViewModel">
                                            <Grid ColumnDefinitions="Auto,*,120" ColumnSpacing="10" Margin="0,3">
                                                <Border Classes="skew" Width="6" Height="18" Background="{Binding Color}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Sound}" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{Binding Label, StringFormat='{}{0} sound'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Saved with your settings. Playback isn't built yet." />
                            </StackPanel>
                        </Border>

                        <!-- chat log -->
                        <Border Classes="section">
                            <StackPanel Spacing="10">
                                <Border Classes="heading skew">
                                    <TextBlock Text="CHAT LOG" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Theme="{StaticResource Skew}" Background="{Binding UtcBg}" Foreground="{Binding UtcFg}" Content="UTC" Command="{Binding PickUtcCommand}" />
                                    <Button Theme="{StaticResource Skew}" Background="{Binding LocalBg}" Foreground="{Binding LocalFg}" Content="Local" Command="{Binding PickLocalCommand}" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding IncludeResults}" OnContent="Include map results" OffContent="Include map results" />
                                <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10">
                                    <SelectableTextBlock Classes="mono" Text="{Binding LogPreview}" TextWrapping="Wrap" Foreground="{StaticResource Body}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- keys & macros -->
                    <Border Grid.Column="2" Classes="section" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <Border Classes="heading skew">
                                <TextBlock Text="KEYS &amp; MACROS" />
                            </Border>
                            <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" Background="Transparent" MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MacroViewModel">
                                        <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10">
                                            <Border Classes="chip" HorizontalAlignment="Left">
                                                <TextBlock Classes="mono" Text="{Binding Key}" FontSize="11" Foreground="{StaticResource Text}" FontWeight="Normal" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Steps}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !Macros.Count}" Text="No macros yet." />

                            <StackPanel Spacing="8" IsVisible="{Binding HasSelectedMacro}">
                                <TextBlock Classes="label" Text="STEPS (one command per line)" />
                                <TextBox Classes="mono" Text="{Binding MacroText}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" Padding="12,8" AutomationProperties.Name="Macro steps" />
                                <ItemsControl ItemsSource="{Binding MacroLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MacroLineViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2" IsVisible="{Binding Bad}">
                                                <Border Width="3" Background="{Binding Bar}" />
                                                <TextBlock Classes="mono" Text="{Binding Number}" Width="16" />
                                                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource ErrorFg}" TextWrapping="Wrap" MaxWidth="320" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Theme="{StaticResource Skew}" Content="{Binding SetKeyLabel}" Command="{Binding SetKeyCommand}" />
                                    <Button Theme="{StaticResource Skew}" Background="{StaticResource Chip}" Content="Clear key" Command="{Binding ClearKeyCommand}" />
                                    <Button Theme="{StaticResource Skew}" Background="{StaticResource ErrorBg}" Foreground="{StaticResource ErrorFg}" Content="Delete"
                                            Command="{Binding DeleteMacroCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,6,0,0">
                                <TextBox Text="{Binding NewMacroName}" PlaceholderText="new macro name" AutomationProperties.Name="New macro name" />
                                <Button Grid.Column="1" Theme="{StaticResource Skew}" Content="New macro" Command="{Binding NewMacroCommand}" MinHeight="38" />
                            </Grid>
                            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="Keys: F1–F24, or a combination with Ctrl or Alt. A macro can't run another macro or message more than one user." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
